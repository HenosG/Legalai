generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  AT_RISK
  COMPLETED
  CANCELLED
}

enum ProjectHealth {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  UNKNOWN
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  BLOCKED
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PortalAccessMode {
  INVITE_ONLY
  CLIENT_EMAIL
  PUBLIC_LINK
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum IntegrationProvider {
  STRIPE
  CLERK
  GEMINI
  RESEND
}

// ─────────────────────────────────────────────────────────────────────────────
// Core tenancy and authentication
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id               String   @id @default(cuid())
  name             String
  clerkOrgId       String   @unique
  plan             String   @default("free")
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users         User[]
  clients       Client[]
  leads         Lead[]
  aiIntakes     AIIntake[]
  proposals     Proposal[]
  contracts     Contract[]
  projects      Project[]
  milestones    Milestone[]
  invoices      Invoice[]
  payments      Payment[]
  tasks         Task[]
  activityLogs  ActivityLog[]
  documents     Document[]
  caseStudies   CaseStudy[]
  testimonials  Testimonial[]

  workspaceSettings       WorkspaceSettings?
  clientPortalSettings    ClientPortalSettings?
  notificationPreferences NotificationPreference[]
  integrationConnections  IntegrationConnection[]

  @@index([clerkOrgId])
}

model User {
  id              String   @id
  email           String   @unique
  firstName       String?
  lastName        String?

  // Internal Prisma Organization ID
  organizationId  String?

  // Clerk Organization ID
  clerkOrgId      String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace?

  clients      Client[]
  leads        Lead[]
  aiIntakes    AIIntake[]
  proposals    Proposal[]
  contracts    Contract[]
  projects     Project[]
  milestones   Milestone[]
  invoices     Invoice[]
  payments     Payment[]
  tasks        Task[]
  activityLogs ActivityLog[]
  documents    Document[]

  assignedTasks Task[] @relation("TaskAssignee")

  notificationPreferences NotificationPreference[]

  @@index([organizationId])
  @@index([clerkOrgId])
}

model Workspace {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String?  @unique

  businessName String
  businessSlug String   @unique
  currency     String   @default("USD")
  country      String   @default("US")
  industry     String
  businessType String
  agentName    String   @default("Rulo")

  proposalTemplateId String?
  crmPipelineId      String?
  invoiceTemplateId  String?

  isOnboarded Boolean   @default(false)
  onboardedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  onboardingData    OnboardingResponse[]
  proposalTemplates ProposalTemplate[]
  crmPipelines      CrmPipeline[]
  invoiceTemplates  InvoiceTemplate[]

  @@index([userId])
  @@index([organizationId])
  @@index([businessSlug])
}

model OnboardingResponse {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  questionKey String
  answer      String    @db.Text
  metadata    Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Settings, Client Portal, Notifications, and Integrations
// ─────────────────────────────────────────────────────────────────────────────

model WorkspaceSettings {
  id                        String        @id @default(cuid())
  organizationId            String        @unique
  organization              Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  timezone                  String        @default("America/Toronto")
  locale                    String        @default("en-CA")
  dateFormat                String        @default("MMM d, yyyy")
  weekStartsOn              Int           @default(1)

  defaultCurrency           String        @default("CAD")
  defaultProposalExpiryDays Int           @default(30)
  defaultPaymentTermsDays   Int           @default(14)
  proposalDefaults          Json?

  defaultProjectStatus      ProjectStatus @default(PLANNING)
  defaultProjectHealth      ProjectHealth @default(UNKNOWN)
  defaultTaskPriority       TaskPriority  @default(MEDIUM)
  projectWorkingDays        Json?
  projectDefaultView        String        @default("board")
  projectDefaults           Json?

  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([organizationId])
}

model ClientPortalSettings {
  id                    String           @id @default(cuid())
  organizationId        String           @unique
  organization          Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  enabled               Boolean          @default(false)

  portalName            String?
  portalSlug            String           @unique
  logoUrl               String?
  primaryColor          String           @default("#18181B")

  welcomeTitle          String?          @db.Text
  welcomeMessage        String?          @db.Text
  supportEmail          String?
  supportUrl            String?

  accessMode            PortalAccessMode @default(INVITE_ONLY)

  allowClientMessages   Boolean          @default(true)
  showProjectProgress   Boolean          @default(true)
  showInvoices          Boolean          @default(true)
  showProposals         Boolean          @default(true)
  showDocuments         Boolean          @default(true)

  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([portalSlug])
}

model NotificationPreference {
  id             String              @id @default(cuid())
  organizationId String?
  userId         String?

  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?               @relation(fields: [userId], references: [id], onDelete: Cascade)

  eventKey       String
  channel        NotificationChannel
  enabled        Boolean             @default(true)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([organizationId, userId, eventKey, channel])
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, eventKey])
  @@index([userId, eventKey])
}

model IntegrationConnection {
  id                  String              @id @default(cuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  provider            IntegrationProvider
  status              String              @default("DISCONNECTED")

  // Safe metadata only. Never store API keys, tokens, or provider secrets.
  externalAccountId   String?
  externalAccountName String?
  metadata            Json?

  connectedAt         DateTime?
  lastSyncedAt        DateTime?
  lastError           String?             @db.Text

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([organizationId, provider])
  @@index([organizationId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Leads, AI intake, CRM, and proposals
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  email          String?
  company        String?
  phone          String?
  source         String?
  status         String   @default("NEW")
  estimatedValue Float?
  notes          String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
}

model AIIntake {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  rawMessage     String   @db.Text
  contactName    String
  company        String?
  email          String?
  projectType    String
  budgetMin      Float?
  budgetMax      Float?
  timeline       String?
  requirements   String[]
  score          Int      @default(0)
  scoreBreakdown Json?
  confidence     Json?
  status         String   @default("PENDING_REVIEW")
  clientId       String?

  proposals Proposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([organizationId, status])
}

model Client {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  email   String?
  company String?
  phone   String?
  status  String   @default("active")
  tags    String[]
  notes   String?  @db.Text

  assignedUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects    Project[]
  proposals   Proposal[]
  contracts   Contract[]
  invoices    Invoice[]
  tasks       Task[]
  clientNotes ClientNote[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
  @@index([assignedUserId])
  @@index([organizationId, status])
}

model ClientNote {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  body      String   @db.Text
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Proposal {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  intakeId String?
  intake   AIIntake? @relation(fields: [intakeId], references: [id], onDelete: SetNull)

  project Project?

  title   String
  version Int    @default(1)
  amount  Float
  status  String @default("draft")

  scopeOfWork Json?
  timeline    Json?
  pricing     Json?
  terms       Json?

  caseStudies  String[]
  testimonials String[]
  signature    Json?
  documentUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
  @@index([intakeId])
  @@index([organizationId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Contracts, Projects, Milestones, and Tasks
// ─────────────────────────────────────────────────────────────────────────────

model Contract {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  proposalId  String?
  title       String
  value       Float
  status      String    @default("DRAFT")
  signedAt    DateTime?
  expiresAt   DateTime?
  documentUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, status])
}

model Project {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  proposalId String?   @unique
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  name        String
  description String? @db.Text

  status ProjectStatus @default(PLANNING)
  health ProjectHealth @default(UNKNOWN)

  budget   Decimal? @db.Decimal(12, 2)
  currency String   @default("CAD")

  progress Int @default(0)

  startDate   DateTime?
  targetDate  DateTime?
  completedAt DateTime?

  coverImageUrl String?
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  tasks      Task[]

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([organizationId, targetDate])
  @@index([organizationId, updatedAt])
}

model Milestone {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(NOT_STARTED)

  position Int @default(0)

  dueDate     DateTime?
  completedAt DateTime?

  amount Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@index([projectId, position])
  @@index([projectId, status])
  @@index([organizationId, dueDate])
  @@index([userId, status])
}

model Task {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  title       String
  description String? @db.Text

  status   TaskStatus   @default(TODO)
  priority TaskPriority @default(MEDIUM)

  position Int @default(0)

  dueDate     DateTime?
  completedAt DateTime?

  estimatedHours Decimal? @db.Decimal(8, 2)
  actualHours    Decimal? @db.Decimal(8, 2)

  labels   String[]
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([assigneeId, status])
  @@index([organizationId, status])
  @@index([projectId, status, position])
  @@index([milestoneId, status, position])
  @@index([clientId, status])
  @@index([organizationId, dueDate])
}

model Invoice {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  amount          Float
  amountPaid      Float     @default(0)
  status          String    @default("UNPAID")
  dueDate         DateTime?
  stripeInvoiceId String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([organizationId])
  @@index([clientId])
  @@index([organizationId, status])
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  amount                Float
  method                String
  status                String  @default("completed")
  stripePaymentIntentId String? @unique

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Activity, files, and public lead capture
// ─────────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  action      String
  description String
  module      String?
  targetId    String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([organizationId, module])
  @@index([organizationId, createdAt])
}

model Document {
  id             String   @id @default(uuid())
  userId         String
  organizationId String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     String
  typeId   String
  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([type, typeId])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
}

model WebinarAccessRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String
  company   String?
  jobTitle  String?
  useCase   String
  message   String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspace templates and social proof
// ─────────────────────────────────────────────────────────────────────────────

model ProposalTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model CrmPipeline {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name   String
  stages Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model InvoiceTemplate {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name    String
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model CaseStudy {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title      String
  clientName String?
  content    String  @db.Text
  metrics    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Testimonial {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientName    String
  clientCompany String?
  avatarUrl     String?
  content       String  @db.Text
  rating        Int     @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}